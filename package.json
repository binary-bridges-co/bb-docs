{
  "name": "bb-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation hub for the Binary Bridges products — docs.binarybridges.co",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/check-csp.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "astro": "astro",
    "sync:sign": "node scripts/sync-product.mjs sign",
    "check:csp": "node scripts/check-csp.mjs",
    "test:prod": "playwright test --config playwright.prod.config.ts",
    "verify:deploy": "bash scripts/verify-deploy.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
