---
import Logo from '../brand/Logo.astro';
import type { Locale, Product } from '../../config/products';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const prefix = locale === 'es' ? '' : `/${locale}`;
const docsHref = `${prefix}/${product.id}/`;
const labels = {
  es: { open: 'Abrir la documentación', app: 'Ir a la aplicación' },
  en: { open: 'Open the documentation', app: 'Go to the application' },
}[locale];
---

<li class="card" data-product={product.id}>
  <a class="card__main" href={docsHref}>
    <span class="card__mark"><Logo size={40} product={product.id === 'sign' ? 'sign' : 'parent'} /></span>
    <span class="card__name">{product.name}</span>
    <span class="card__tagline">{product.tagline[locale]}</span>
    <span class="card__cta">{labels.open}</span>
  </a>
  <a class="card__app" href={product.appUrl} rel="noopener">{labels.app}</a>
</li>

<style>
  .card {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .card__main {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-card, 16px);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color var(--duration-fast, 150ms);
  }
  .card__main:hover,
  .card__main:focus-visible {
    border-color: var(--sl-color-accent);
  }
  .card__mark {
    display: block;
    margin-bottom: 0.5rem;
  }
  .card__name {
    font-family: var(--sl-font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .card__tagline {
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
  .card__cta {
    margin-top: 0.5rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .card__app {
    justify-self: start;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .card__app:hover {
    color: var(--sl-color-text);
  }
</style>
