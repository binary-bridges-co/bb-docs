---
/**
 * The header of a mirrored legal text: its version and date (LV contract D-17) and, on an English
 * translation, the note that the Spanish version prevails. Rendered only by the PageTitle override
 * (`src/lib/legal.ts` decides what it shows); `tests/unit/legal.test.ts` checks the built pages.
 */
interface Props {
  locale: 'es' | 'en';
  /** From the page's `legalVersion` frontmatter: "Versión 4 · 2026-10-20". Absent for the guides. */
  version?: string;
  prevails: boolean;
}

const { locale, version, prevails } = Astro.props;
const t = {
  es: { prevails: '' },
  en: { prevails: 'This translation is provided for convenience. The Spanish version prevails.' },
}[locale];
---

<div class="bb-legal-header" data-legal-version={version}>
  {version && <span><strong>{version}</strong></span>}
  {prevails && t.prevails && <span>{t.prevails}</span>}
</div>
