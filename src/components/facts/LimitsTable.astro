---
/**
 * Every bb-sign number in one table, from the fact sheet. Labels are translated
 * here so the sheet stays language-neutral. Sources stay in the fact sheet; readers
 * do not need code paths.
 */
import { LIMITS } from '../../content/facts/sign';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;

const LABELS: Record<string, { es: string; en: string }> = {
  linkTtl: { es: 'Validez del enlace de firma (por defecto)', en: 'Signing link validity (default)' },
  expirySweep: { es: 'Frecuencia del barrido de sobres vencidos', en: 'Expiry sweep frequency' },
  otpDigits: { es: 'Dígitos del código de un solo uso', en: 'One-time code digits' },
  otpValidity: { es: 'Validez del código', en: 'Code validity' },
  otpAttempts: { es: 'Intentos por código', en: 'Attempts per code' },
  otpResend: { es: 'Espera para reenviar el código', en: 'Wait before resending the code' },
  otpVerifiedValidity: { es: 'Tiempo para firmar tras verificar el código', en: 'Time to sign after verifying the code' },
  uploadMax: { es: 'Tamaño máximo por documento', en: 'Maximum size per document' },
  unassignedMax: { es: 'Documentos sin sobre por organización', en: 'Unattached documents per organization' },
  unassignedRetention: { es: 'Conservación de documentos sin sobre', en: 'Unattached documents kept for' },
  downloadUrl: { es: 'Validez de un enlace de descarga', en: 'Download link validity' },
  archiveAfter: { es: 'Paso a "Archivados" tras la creación', en: 'Moved to "Archived" after creation' },
  reminderThreshold: { es: 'Primer recordatorio al firmante', en: 'First reminder to a signer' },
  reminderCooldown: { es: 'Espera entre recordatorios', en: 'Wait between reminders' },
  labelKeyName: { es: 'Longitud máxima del nombre de una etiqueta', en: 'Label key name, max length' },
  labelValue: { es: 'Longitud máxima del valor de una etiqueta', en: 'Label value, max length' },
  listCap: { es: 'Tope del contador de la lista de sobres', en: 'Envelope list counter cap' },
  tokenLifetime: { es: 'Vida de un token de acceso (API)', en: 'Access token lifetime (API)' },
  credentialsPerOrg: { es: 'Credenciales de API activas por organización', en: 'Active API credentials per organization' },
  revokedListed: { es: 'Credenciales revocadas visibles durante', en: 'Revoked credentials listed for' },
  invitationLink: { es: 'Validez del enlace de invitación a un usuario', en: 'User invitation link validity' },
  membershipsPerPrincipal: { es: 'Membresías de espacio por persona o credencial', en: 'Workspace memberships per person or credential' },
  webhooksPerOrg: { es: 'Webhooks por organización', en: 'Webhooks per organization' },
  webhookTolerance: { es: 'Tolerancia de reloj en la firma de webhooks', en: 'Clock tolerance for webhook signatures' },
  webhookRetries: { es: 'Reintentos de entrega de webhooks', en: 'Webhook delivery retries' },
  webhookDisable: { es: 'Escaleras agotadas seguidas antes de desactivar', en: 'Exhausted ladders before disabling' },
  webhookRotationGrace: { es: 'Gracia al rotar el secreto de un webhook', en: 'Grace after rotating a webhook secret' },
  webhookLog: { es: 'Historial de entregas conservado', en: 'Delivery history kept for' },
  certFile: { es: 'Tamaño máximo del archivo de certificado', en: 'Certificate file, max size' },
  certKeyBits: { es: 'Tamaño mínimo de la llave del certificado (bits)', en: 'Certificate key, min size (bits)' },
  certCache: { es: 'Tiempo hasta que un certificado nuevo sella', en: 'Time until a new certificate seals' },
  quotaWarning: { es: 'Aviso de cuota al alcanzar', en: 'Quota warning at' },
  retentionPolicy: { es: 'Conservación de documentos firmados (política)', en: 'Signed documents kept (policy)' },
  archivePolicy: { es: 'Archivo en frío (política)', en: 'Cold archive (policy)' },
};

const heading = { es: ['Concepto', 'Valor'], en: ['Item', 'Value'] }[locale];
---

<table class="bb-limits">
  <thead>
    <tr>
      <th scope="col">{heading[0]}</th>
      <th scope="col">{heading[1]}</th>
    </tr>
  </thead>
  <tbody>
    {
      LIMITS.map((row) => (
        <tr>
          <th scope="row">{LABELS[row.key]?.[locale] ?? row.key}</th>
          <td class="bb-mono">{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

